power_change = -10.0
food_change = -5.0
shield_change = 0.0

[sub_resource type="Resource" id="choice_2"]
script = ExtResource("2")
text = "Shut down machines, stay in hab"
icon = "🔌"
life_support_change = -10.0
power_change = 10.0
food_change = 0.0
shield_change = 0.0

[sub_resource type="Resource" id="choice_3"]
script = ExtResource("2")
text = "Keep working on the dish outside"
icon = "🔧"
life_support_change = -25.0
power_change = 0.0
food_change = 0.0
shield_change = -10.0

[resource]
script = ExtResource("1")
title = "Solar Storm Warning!"
description = "The Sun just blasted out a wave of energy! It will reach Mars in hours. Based on a real NASA DONKI solar flare."
choices = [SubResource("choice_1"), SubResource("choice_2"), SubResource("choice_3")]
