[gd_resource type="Resource" script_class="EventData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/data/event_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/data/event_choice.gd" id="2"]

[sub_resource type="Resource" id="choice_1"]
script = ExtResource("2")
text = "Water the plants"
icon = "💧"
life_support_change = -15.0
power_change = 0.0
food_change = 15.0
shield_change = 0.0

[sub_resource type="Resource" id="choice_2"]
script = ExtResource("2")
text = "Grow fewer plants"
icon = "🌿"
life_support_change = -5.0
power_change = 0.0
food_change = 5.0
shield_change = 0.0

[sub_resource type="Resource" id="choice_3"]
script = ExtResource("2")
text = "Save drinking water"
icon = "🚰"
life_support_change = 5.0
power_change = 0.0
food_change = -10.0
shield_change = 0.0

[resource]
script = ExtResource("1")
title = "Water Shortage for Crops"
description = "There isn't enough water for you AND the plants. Something has to give."
choices = [SubResource("choice_1"), SubResource("choice_2"), SubResource("choice_3")]
